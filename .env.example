_JAVA_OPTIONS=-Xmx10g
OPENAI_API_KEY=sk-unused-arc-placeholder
HF_HOME=/content/drive/MyDrive/hf_cache
HF_TOKEN=

USE_DRIVE=true
DRIVE_ROOT=/content/drive/MyDrive/arc_phase1
LOCAL_ROOT=/content/arc_phase1
LOCAL_EMBED_DIR=/content/pubmed_embeddings

CORPUS_NAME=MedText
TOP_K=3
RETRIEVERS=BM25,Contriever,SPECTER,MedCPT
DEFAULT_N_QUESTIONS=10

NLI_MODEL=cross-encoder/nli-deberta-v3-small
NLI_CONTRADICTION=contradiction
NLI_THRESHOLD=0.7
NLI_BATCH_SIZE=32

PKE_MODEL=Qwen/Qwen2.5-3B-Instruct
N_PROBES=7
PKE_TEMPERATURE=0.8
PKE_KNOWN_THRESH=0.6
PKE_MAX_NEW_TOKENS=256
